#!/usr/bin/env bash
# pre-push: what CI and the box's deploy gate run, before the push leaves the
# laptop — secrets in the commits being pushed and in the pushed tree, then
# this repo's own checks (.githooks/checks.sh). Read only.
# Bypass in an emergency with SKIP_HOOKS=1 (or --no-verify) and say why.
set -u
# shellcheck source=lib.sh
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

zero=0000000000000000000000000000000000000000
cfg=$(gitleaks_config)
tips=()

scan_tree() {
  local d rc st; d=$(mktemp -d)
  # Both halves must succeed: an archive that failed leaves an empty (or
  # partial) directory, and gitleaks finds nothing in nothing.
  git archive "$1" | tar -x -C "$d"; st=("${PIPESTATUS[@]}")
  if [ "${st[0]}" != 0 ] || [ "${st[1]}" != 0 ]; then
    echo "could not unpack the tree at $1 (git archive exit ${st[0]}, tar exit ${st[1]}) — nothing was scanned"
    rm -rf "$d"; return 1
  fi
  gitleaks dir "$d" --config "$2" --no-banner --redact=90 --exit-code 1 -v; rc=$?
  rm -rf "$d"; return $rc
}

while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                # a branch delete: nothing to scan
  if [ "$rsha" = "$zero" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    range="$lsha --not --remotes"                     # new branch: what no remote has yet
  else
    range="$rsha..$lsha"
  fi
  tips+=("$lsha")
  if ! has gitleaks; then skipped gitleaks "not installed (brew install gitleaks)"
  elif [ ! -f "$cfg" ]; then skipped gitleaks "no $cfg (foldrun-infra not checked out beside this repo)"
  else
    n=$(git rev-list --count $range)
    step "gitleaks: $n commit(s) being pushed" \
      gitleaks git --log-opts="$range" --config "$cfg" --no-banner --redact=90 --exit-code 1 -v .
    # The tree as pushed — a fresh checkout, as the deploy gate sees it, so
    # ignored local files (.env, data/) are not mistaken for the push.
    step "gitleaks: tree at ${lsha:0:7}" scan_tree "$lsha" "$cfg"
  fi
done

if [ ${#tips[@]} = 0 ]; then finish; fi

# ---- the checks on another machine (foldrun.checksHost)
#
# `git config foldrun.checksHost box` (or FOLDRUN_CHECKS_HOST=box) runs the
# repo checks below on that host over ssh instead of here — the owner's
# laptop sends its builds to the box (2 Nov 2026), which has the cores. Unset
# (CI, everyone else) nothing changes. gitleaks above still runs here: it is
# quick, and the secrets should be caught before anything leaves.
#
# What is checked is still what is pushed: the pushed commit goes to a bare
# repo on the host (~/foldrun-prepush/git/<repo>.git), with the sibling repos
# the checks read (web reads core, platform, docs, infra) at their HEAD, and
# each is checked out fresh in ~/foldrun-prepush/run/<id>. node_modules comes
# from a cache keyed by package-lock.json and package.json, so only a changed
# manifest pays for an install. The run folder and its refs are removed afterwards. A host that
# cannot be reached fails the push and says so; it never falls back to here.
CHECKS_HOST=${FOLDRUN_CHECKS_HOST-$(git -C "$ROOT" config --get foldrun.checksHost 2>/dev/null || true)}
CHECKS_SSH=${FOLDRUN_CHECKS_SSH:-ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30}
SIBLINGS="foldrun-core foldrun-platform foldrun-web foldrun-docs foldrun-infra foldrun-cli"

# The refs the history checks compare against: origin/main (api-guard,
# migration-guard: the merge base) and the published tags (infra's box versions = what
# is deployed). Kept on the host between runs; already on GitHub, so already
# scanned when they were pushed (Codex review).
baseline_refs() {  # baseline_refs <repo dir> — refspecs, one per word
  git -C "$1" rev-parse -q --verify refs/remotes/origin/main >/dev/null || return 0
  echo "+refs/remotes/origin/main:refs/remotes/origin/main"
  # Only tags already in origin/main's history — published, so scanned when
  # pushed; a local tag on unpublished commits stays here (Codex review).
  # The newest twenty: api-guard reads the newest box version.
  git -C "$1" for-each-ref --merged=refs/remotes/origin/main --sort=-creatordate --count=20 --format='+%(refname):%(refname)' refs/tags
}

remote_checks() {  # remote_checks <sha>
  local t id r pushed rc
  # An annotated tag arrives as the tag object: what is checked is its
  # commit, which is also all a branch ref can hold (Codex review).
  t=$(git -C "$HOME_ROOT" rev-parse --verify -q "$1^{commit}") || { FAILED=1; say "${1:0:7} is not a commit or a tag of one: nothing to check"; return; }
  id="$REPO-${t:0:12}-$$-$(date +%s)"
  # shellcheck disable=SC2086
  if ! $CHECKS_SSH "$CHECKS_HOST" "umask 022; B=foldrun-prepush; mkdir -p \$B/git \$B/run \$B/nm && for r in $REPO $SIBLINGS; do [ -d \$B/git/\$r.git ] || git init -q --bare \$B/git/\$r.git; done" </dev/null >/dev/null 2>&1; then
    FAILED=1
    say "cannot reach $CHECKS_HOST to run the checks (foldrun.checksHost). Bring it back, or run them yourself and push with SKIP_HOOKS=1 saying why — they are not run here instead."
    return
  fi
  pushed="$REPO"
  # Ours at the pushed commit; each sibling at its HEAD. --no-verify: this
  # push must not run this hook again.
  if ! GIT_SSH_COMMAND="$CHECKS_SSH" git -C "$HOME_ROOT" push --no-verify -q --force "$CHECKS_HOST:foldrun-prepush/git/$REPO.git" "$t:refs/heads/check/$id" $(baseline_refs "$HOME_ROOT") >/dev/null 2>&1; then
    FAILED=1; say "could not send ${t:0:7} to $CHECKS_HOST"; return
  fi
  for r in $SIBLINGS; do
    [ "$r" = "$REPO" ] && continue
    git -C "$PARENT/$r" rev-parse --git-dir >/dev/null 2>&1 || continue   # a clone or a worktree
    # Its commits no remote has yet were never through a pre-push scan: scan
    # them before they leave, and keep the sibling here if that fails or
    # cannot run (Codex review).
    if [ -n "$(git -C "$PARENT/$r" rev-list -n1 HEAD --not --remotes 2>/dev/null)" ]; then
      if ! has gitleaks || [ ! -f "$cfg" ] || ! gitleaks git "$PARENT/$r" --log-opts="HEAD --not --remotes" --config "$cfg" --no-banner --redact=90 --exit-code 1 >/dev/null 2>&1; then
        say "note: $r has unpushed commits that did not pass (or could not run) the secret scan — not sent; checks that read it may fail"
        continue
      fi
    fi
    if GIT_SSH_COMMAND="$CHECKS_SSH" git -C "$PARENT/$r" push --no-verify -q --force "$CHECKS_HOST:foldrun-prepush/git/$r.git" "HEAD:refs/heads/check/$id" $(baseline_refs "$PARENT/$r") >/dev/null 2>&1; then
      pushed="$pushed $r"
    else
      say "note: could not send $r to $CHECKS_HOST; checks that read it may fail"
    fi
  done
  say "checking ${t:0:7} on $CHECKS_HOST (siblings at their HEAD: ${pushed#"$REPO"})"
  # shellcheck disable=SC2086,SC2016
  $CHECKS_SSH "$CHECKS_HOST" "bash -s -- '$id' '$REPO' '$pushed'" <<'REMOTE'
set -u; umask 022
id=$1; repo=$2; pushed=$3
B=$HOME/foldrun-prepush; D=$B/run/$id
# TMPDIR short and apart from the run folder: a Unix socket path holds 108
# bytes, and web's installer tests bind one inside a temp folder (a long
# run-folder name made them fail on the box, 2 Nov 2026).
mkdir -p "$D" "$B/t"; T=$(mktemp -d "$B/t/XXXXXX")
cleanup() {
  rm -rf "$T"
  for r in $pushed; do
    git -C "$B/git/$r.git" worktree remove --force "$D/$r" >/dev/null 2>&1
    git -C "$B/git/$r.git" worktree prune >/dev/null 2>&1
    git -C "$B/git/$r.git" update-ref -d "refs/heads/check/$id" >/dev/null 2>&1
  done
  rm -rf "$D"
}
trap cleanup EXIT
# Old runs a dropped connection left behind.
find "$B/run" "$B/t" -mindepth 1 -maxdepth 1 -mmin +720 -exec rm -rf {} + 2>/dev/null
export PATH="$HOME/foldrun-e2e/node/bin:$B/bin:$PATH" TMPDIR="$T"
for r in $pushed; do
  git -C "$B/git/$r.git" worktree add -q --detach "$D/$r" "refs/heads/check/$id" || { echo "could not check out $r"; exit 1; }
  # The repo's own packages, and a package one folder down (admin's console/).
  # Keyed on the manifest too: a package.json changed without its lockfile
  # must meet npm ci's refusal, not a warm cache (Codex review).
  for lock in "$D/$r/package-lock.json" "$D/$r"/*/package-lock.json; do
    [ -f "$lock" ] || continue
    pkg=$(dirname "$lock"); sub=${pkg#"$D/$r"}; key="$r${sub//\//_}"
    nm="$B/nm/$key-$(cat "$lock" "$pkg/package.json" 2>/dev/null | sha256sum | cut -c1-16)"
    if [ ! -d "$nm/node_modules" ]; then
      if (cd "$pkg" && npm ci --ignore-scripts --no-audit --no-fund >"$D/npm-$key.log" 2>&1); then
        mkdir -p "$nm.$$" && mv "$pkg/node_modules" "$nm.$$/" && { mv -T "$nm.$$" "$nm" 2>/dev/null || rm -rf "$nm.$$"; }
      else
        echo "npm ci failed in $r$sub:"; tail -n 30 "$D/npm-$key.log"; exit 1
      fi
    fi
    ln -s "$nm/node_modules" "$pkg/node_modules"
  done
done
cd "$D/$repo" || exit 1
# Fail closed: a commit without check definitions is not a commit that passed.
[ -f .githooks/lib.sh ] && [ -f .githooks/checks.sh ] || { echo "this commit has no .githooks/lib.sh or checks.sh: nothing to run, so it is not passed"; exit 1; }
bash -c '. .githooks/lib.sh && . .githooks/checks.sh && declare -F repo_checks >/dev/null || { echo "the checks did not load"; exit 1; }; repo_checks; finish' pre-push@box
REMOTE
  rc=$?
  [ $rc = 0 ] || FAILED=1
}

# `foldrun.checksHost github` (2 Nov 2026, when the box was lost and the
# owner moved testing to GitHub CI/CD): the suites are not run on this
# machine at all. Each repo's own CI runs them on the push, and
# foldrun-infra's dev-deploy.yml runs every suite again before anything
# reaches dev. The secret scan above has run here — secrets are caught
# before they leave — and its verdict is this hook's.
if [ "$CHECKS_HOST" = github ]; then
  [ "$FAILED" = 1 ] || say "the suites run on GitHub (each repo's CI, and dev-deploy.yml before dev): only the secret scan ran here (foldrun.checksHost=github)"
  finish
fi

if [ -n "$CHECKS_HOST" ] && [ "$CHECKS_HOST" != local ]; then
  # A secret found above: nothing leaves for the host (Codex review). Objects
  # sent there would outlive the ref this run deletes.
  if [ "$FAILED" = 1 ]; then say "the secret scan failed: nothing was sent to $CHECKS_HOST"; finish; fi
  # git exports GIT_DIR to hooks: a `git -C <sibling> push` would push THIS
  # repo under the sibling's name. The same unset as the local path's, below.
  # shellcheck disable=SC2046
  unset $(git rev-parse --local-env-vars)
  HOME_ROOT=$ROOT
  for t in $(printf '%s\n' "${tips[@]}" | awk '!seen[$0]++'); do remote_checks "$t"; done
  finish
fi

# The repo checks run on what is being pushed, not on the working tree: a
# detached worktree of each pushed commit, beside this checkout (so the
# sibling repos resolve as they do here), sharing this checkout's
# node_modules. Uncommitted work here — perhaps another session's — neither
# hides a failure in the push nor causes one. A repo whose tooling cannot run
# from a worktree sets CHECKS_IN_PLACE=1 in checks.sh; it is checked here
# instead, and only when HEAD is the pushed commit and no tracked file has
# changes, so what passes is still what is pushed.
# shellcheck source=checks.sh
. "$ROOT/.githooks/checks.sh"

# git exports GIT_DIR (and friends) to hooks. A test that makes a throwaway
# repo with `git init` / `git commit` would inherit it and act on THIS repo —
# the infra changelog test did, setting core.bare=true on 1 Oct 2026. The
# checks find their repo from the working directory instead.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

HOME_ROOT=$ROOT
WT=
cleanup_wt() {
  [ -n "$WT" ] || return 0
  git -C "$HOME_ROOT" worktree remove --force "$WT" >/dev/null 2>&1 || rm -rf "$WT"
  git -C "$HOME_ROOT" worktree prune >/dev/null 2>&1
  WT=
}
trap cleanup_wt EXIT INT TERM

for t in $(printf '%s\n' "${tips[@]}" | awk '!seen[$0]++'); do
  if [ "${CHECKS_IN_PLACE:-0}" = 1 ]; then
    head=$(git -C "$HOME_ROOT" rev-parse HEAD)
    if [ "$t" != "$head" ]; then
      FAILED=1; say "refusing: pushing ${t:0:7} but HEAD is ${head:0:7}, and this repo's checks run in place. Check out ${t:0:7} (or push HEAD), then push again."
      continue
    fi
    if [ -n "$(git -C "$HOME_ROOT" status --porcelain --untracked-files=no)" ]; then
      FAILED=1; say "refusing: tracked files have uncommitted changes, and this repo's checks run in place, so they would be checked instead of ${t:0:7}. Commit or set them aside (they may be another session's: ask), then push again."
      continue
    fi
    ROOT=$HOME_ROOT; repo_checks
    continue
  fi
  WT="$PARENT/.prepush-$REPO-${t:0:12}-$$"
  if ! git -C "$HOME_ROOT" worktree add --detach --quiet "$WT" "$t" >/dev/null 2>&1; then
    FAILED=1; say "could not make a worktree of ${t:0:7} at $WT to check it"; WT=; continue
  fi
  [ -d "$HOME_ROOT/node_modules" ] && ln -s "$HOME_ROOT/node_modules" "$WT/node_modules"
  say "checking ${t:0:7} in a worktree of the pushed commit"
  ROOT=$WT; repo_checks; ROOT=$HOME_ROOT
  cleanup_wt
done

finish
